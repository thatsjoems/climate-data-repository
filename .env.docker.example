# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# real values before any deployment beyond local training/demo use.
# Docker Compose reads a file literally named ".env" automatically - no
# extra flag needed.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Long, random, unique - e.g. generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret

# Set to "production" to make the backend refuse to start if SECRET_KEY is empty,
# shorter than 32 characters, or still a placeholder like the sample above
# (see app/core/startup_checks.py).
ENVIRONMENT=development

# Optional SMTP (leave blank to keep the manual credential-relay fallback)
SMTP_HOST=
SMTP_FROM_EMAIL=

# Optional - only if you opt in to the restricted database role (docs/DATABASE_OPERATIONS.md,
# section 4b). Letters and digits only; the same value you gave database/roles/create_app_role.sql.
# APP_DB_PASSWORD=change-me-letters-and-digits-only
