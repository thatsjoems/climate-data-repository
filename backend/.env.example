# Copy this file to ".env" (without "example") and fill in your own values.
#
# OPTION A - Simplest for a personal computer (SQLite - no PostgreSQL server needed):
DATABASE_URL=sqlite:///./cdr.db
#
# OPTION B - Use the PostgreSQL you installed (comment out the line above and
# uncomment the line below instead):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/climate_data_repository

SECRET_KEY=change-this-to-a-long-unique-secret-before-production-use
ACCESS_TOKEN_EXPIRE_MINUTES=480

# OPTIONAL: automatic email delivery for approved access/password-reset requests.
# Leave these blank (default) and the system will show the credential once to the
# approving Admin instead, who relays it manually - nothing breaks either way.
# Example using a Gmail account with an "App Password":
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
