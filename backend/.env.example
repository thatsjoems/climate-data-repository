# Copy this file to ".env" (without "example") and fill in your own values.
#
# OPTION A - Simplest for a personal computer (SQLite - no PostgreSQL server needed):
DATABASE_URL=sqlite:///./cdr.db
#
# OPTION B - Use the PostgreSQL you installed (comment out the line above and
# uncomment the line below instead):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/climate_data_repository

SECRET_KEY=change-this-to-a-long-unique-secret-before-production-use
ACCESS_TOKEN_EXPIRE_MINUTES=480
