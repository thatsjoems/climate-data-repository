# Nakili faili hii uite ".env" (bila neno "example") kisha jaza taarifa zako.
#
# CHAGUO A - Rahisi zaidi kwa Kompyuta binafsi (SQLite - hauitaji PostgreSQL kuwa 'running'):
DATABASE_URL=sqlite:///./cdr.db
#
# CHAGUO B - Kutumia PostgreSQL uliyoisakinisha (ondoa # mstari ufuatao na weka # mbele ya mstari wa juu):
# DATABASE_URL=postgresql://postgres:WEKA_PASSWORD_YAKO_HAPA@localhost:5432/climate_data_repository

SECRET_KEY=badilisha-hii-na-neno-siri-refu-na-la-kipekee-kabla-ya-uzalishaji
ACCESS_TOKEN_EXPIRE_MINUTES=480
